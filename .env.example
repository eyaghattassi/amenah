# ============================================
# Amenah - Example environment configuration
# ============================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
#
# On Windows PowerShell you can load it with:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim(), 'Process')
#     }
#   }

# ---------- Flask ----------
# 64+ hex chars. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AMENAH_SECRET_KEY=
FLASK_HOST=127.0.0.1
PORT=8080

# ---------- Database ----------
# Leave MYSQL_HOST empty to fall back to SQLite.
# Set AMENAH_USE_SQLITE=1 to force SQLite even if MYSQL_HOST is set.
MYSQL_HOST=
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=amenah
AMENAH_USE_SQLITE=

# ---------- Bootstrap admin account ----------
# Created on first run if the admin_users table is empty.
# If AMENAH_ADMIN_PASSWORD is empty, a random password is printed at startup.
AMENAH_ADMIN_USER=admin
AMENAH_ADMIN_PASSWORD=

# ---------- SMTP (feedback email) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
FEEDBACK_EMAIL_TO=
